#cloud-config
# D3 - Aprovisionamiento 100 % automático al arrancar cada instancia del VMSS.
# Sin secretos aquí: solo el NOMBRE del Key Vault y del secreto. El valor se lee en tiempo de
# ejecución con la identidad administrada (S3). La instancia no tiene salida a Internet, por eso
# no se instalan paquetes: la app usa solo Python 3 (incluido en Ubuntu 24.04) y su librería estándar.

package_update: false
package_upgrade: false

write_files:
  - path: /opt/caribeshop/app.py
    owner: root:root
    permissions: "0755"
    content: |
      ${indent(6, app_py)}

  - path: /etc/caribeshop/caribeshop.env
    owner: root:root
    permissions: "0644"
    content: |
      APP_PORT=80
      KV_NAME=${kv_name}
      SECRET_NAME=${secret_name}
      OPERATOR_IP=${operator_ip}
      DEFAULT_WORK_MS=20
      PYTHONUNBUFFERED=1

  - path: /etc/systemd/system/caribeshop.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=CaribeShop web app
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=simple
      EnvironmentFile=/etc/caribeshop/caribeshop.env
      ExecStart=/usr/bin/python3 -I /opt/caribeshop/app.py
      Restart=always
      RestartSec=2
      # Endurecimiento: usuario efímero sin privilegios, solo puede abrir el puerto 80
      DynamicUser=yes
      AmbientCapabilities=CAP_NET_BIND_SERVICE
      CapabilityBoundingSet=CAP_NET_BIND_SERVICE
      NoNewPrivileges=yes
      ProtectSystem=strict
      ProtectHome=yes
      PrivateTmp=yes
      ProtectKernelTunables=yes
      ProtectKernelModules=yes
      ProtectControlGroups=yes
      RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
      LockPersonality=yes
      LimitNOFILE=65535

      [Install]
      WantedBy=multi-user.target

  - path: /etc/sysctl.d/90-caribeshop.conf
    owner: root:root
    permissions: "0644"
    content: |
      net.core.somaxconn = 4096
      net.ipv4.tcp_max_syn_backlog = 4096
      net.ipv4.ip_local_port_range = 10240 65000

runcmd:
  - sysctl --system
  # Sin Internet no hay actualizaciones automáticas posibles: se evitan reintentos que consumen CPU
  - systemctl disable --now apt-daily.timer apt-daily-upgrade.timer unattended-upgrades.service || true
  - systemctl daemon-reload
  - systemctl enable --now caribeshop.service
  - sleep 3
  - curl -fsS http://127.0.0.1/health && echo " <- caribeshop sano" || echo "caribeshop NO responde"

final_message: "CaribeShop listo tras $UPTIME s"
